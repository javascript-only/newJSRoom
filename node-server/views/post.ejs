<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>포스트 목록</title>
  </head>
  <body>
    <h1><%= post.title %></h1>
    <p><%= post.description%></p>
    <pre><code><%= post.code %></code></pre>
    <form action="/run" method="POST">
      <textarea name="code" rows="10" cols="50"><%= post.code %></textarea
      ><br />
      <button type="submit">코드 실행</button>
    </form>
    <pre id="result"></pre>
    <a href="/">돌아가기</a>
  </body>
</html>
